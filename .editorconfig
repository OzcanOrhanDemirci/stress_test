# One answer for whitespace, so that a diff never contains a change nobody made.
#
# .gitattributes settles what is stored; this settles what is typed. Every
# language here is indented with four spaces: Kotlin, C++, the GLSL shaders, the
# AArch64 assembly, the tools and the resource files.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
# No hard limit: a composable's parameter list or a chart call reads better on
# one line of 120 to 150 characters than wrapped. Keep to that.
max_line_length = off

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so they are not whitespace
# to be tidied away.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[gradlew]
end_of_line = lf
