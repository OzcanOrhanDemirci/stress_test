    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="28dp"
    android:height="23dp"
    android:viewportWidth="56"
    android:viewportHeight="46">
    <group
        android:translateX="-26"
        android:translateY="-26">
        <path
            android:fillColor="#00000000"
            android:pathData="M33.22,68 A24,24 0 1,1 74.78,68"
            android:strokeAlpha="0.22"
            android:strokeColor="@color/icon_foreground"
