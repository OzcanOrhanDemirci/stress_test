    <string name="settings_section_about">About</string>
    <string name="settings_version">Version %1$s</string>
    <string name="settings_about_tagline">The stress test that finds your phone\'s real limits.</string>
    <string name="settings_about_text">Stress Test does not settle for the 100% on the screen. It truly works the processor\'s arithmetic units, its memory path and the graphics chip all at once, and measures the most power your phone can draw, how hot it gets and how it slows down as it heats up.</string>
    <string name="settings_about_cpu">CPU loads written in ARM assembly; each one checks its own results, so a calculation error is caught at once.</string>
    <string name="settings_about_gpu">Vulkan GPU burners and three real-time cinematic 3D scenes.</string>
    <string name="settings_about_analysis">Power, temperatures, clocks and throttling followed second by second, then a clear analysis and a PDF report.</string>
    <string name="settings_about_quality">Graphics quality for every phone, from entry level to the latest flagships.</string>
    <string name="settings_developer">Developed by</string>
    <string name="settings_licenses">Fonts: Space Grotesk, JetBrains Mono (SIL Open Font License 1.1)</string>

    <!-- Safety notice at launch -->
    <string name="notice_title">Device safety</string>
    <string name="notice_subtitle">Please read before you start</string>
    <string name="notice_load">This app tests your phone by running it at full capacity. During a test the phone gets very hot and the battery drains fast.</string>
    <string name="notice_care">Use it with care: run tests out of the case, on a flat, cool surface, never on a pillow or a bed. Stop the test if the phone gets too hot.</string>
    <string name="notice_protection">The device safety setting watches temperatures and the battery and stops a test when needed, but it cannot guarantee protection: every phone is different, and not every sensor can be read.</string>
    <string name="notice_responsibility">You use this app at your own risk: all responsibility for using it and for its consequences is yours.</string>
    <string name="notice_safety_off">Device safety is off: tests will not stop at any temperature limit.</string>
    <string name="notice_dont_show">Don\'t show again</string>
    <string name="notice_accept">I understand</string>

