    <!-- Insights -->
    <string name="insight_safety_title">Device safety stopped the test</string>
    <string name="insight_safety_detail">Reading: %1$s. The results up to that moment are kept.</string>
    <string name="insight_gpu_failed_title">The GPU failed</string>
    <string name="insight_gpu_failed_detail">The graphics driver stopped or reset the GPU. On a weaker phone, try a lower graphics quality.</string>
    <string name="insight_interrupted_title">The test was interrupted</string>
    <string name="insight_interrupted_detail">The app left the screen, which takes the big cores and the GPU away from the load.</string>
    <string name="insight_charging_title">The charger was connected</string>
    <string name="insight_charging_detail">On a charger the battery gauge measures charging and load together, so the power figures are not valid.</string>
    <string name="insight_counter_title">Power from the charge counter</string>
    <string name="insight_counter_detail">This phone reports no instantaneous current: the mean power comes from the battery\'s charge counter, peaks are unknown.</string>
    <string name="insight_throttled_title">Throttling began at %1$s</string>
    <string name="insight_throttled_detail">%1$s first fell below 97%% of its top clock for three seconds: the phone slowed down to hold its temperature.</string>
    <string name="insight_never_throttled_title">No throttling</string>
    <string name="insight_never_throttled_detail">The loaded cores held their top clocks for the whole test.</string>
    <string name="insight_drop_title">Performance fell by %1$s</string>
    <string name="insight_drop_detail_good">The last minute was as fast as the first: the cooling keeps up with this load.</string>
    <string name="insight_drop_detail_info">The phone gave up some speed as it heated: normal under a sustained load.</string>
    <string name="insight_drop_detail_warn">The phone slowed down a lot as it heated: its cooling is the limit under this load.</string>
    <string name="insight_stability_title">Stability %1$s · %2$s</string>
    <string name="insight_stability_detail">The slowest minute against the fastest (the 3DMark measure). Above 95 is excellent.</string>
    <string name="insight_chip_title">%1$s peaked at %2$s</string>
    <string name="insight_chip_detail_over">Past its throttling point: the phone did not hold the chip there. This should not last long.</string>
    <string name="insight_chip_detail_hot">At its throttling point: the phone holds the chip there by lowering its clocks.</string>
    <string name="insight_chip_detail_warm">Warm, within the chip\'s working range.</string>
    <string name="insight_chip_detail_cool">Cool: this load did not heat the chip much.</string>
    <string name="insight_battery_title">Battery %1$s → %2$s</string>
    <string name="insight_battery_detail">The battery warmed by %1$s °C.</string>
    <string name="insight_battery_detail_hot">The battery got hot (+%1$s °C): heat ages a battery faster.</string>
    <string name="insight_drain_title">Battery drained %1$s%% per hour</string>
    <string name="insight_drain_detail">Battery level lost per hour at this load.</string>
    <string name="insight_no_errors_title">No computation errors</string>
    <string name="insight_no_errors_detail">Every result the load checked was right: the hardware computed correctly under heat.</string>
    <string name="insight_errors_title">%1$d computation errors</string>
    <string name="insight_errors_detail">The hardware returned wrong results under load: a sign of instability (too hot, or an unstable clock or voltage).</string>
