    <!-- Safety -->
    <string name="safety_on_short">Protected</string>
    <string name="safety_off_short">Unprotected</string>
    <string name="safety_status_on">On: the phone is protected</string>
    <string name="safety_status_off">Off: no protection</string>
    <string name="safety_on_text">The app watches the phone throughout the test and stops it before it gets dangerously hot or flat:</string>
    <string name="safety_limit_battery">Stops when the battery reaches %1$s</string>
    <string name="safety_limit_chip">Stops when the CPU or GPU reaches %1$s</string>
    <string name="safety_limit_skin">Stops when the case reaches %1$s</string>
    <string name="safety_limit_thermal">Stops when Android reports %1$s thermal status</string>
    <string name="safety_limit_level">Stops when the battery falls to %1$s</string>
    <string name="safety_limit_start">Will not start while the phone is hot (battery %1$s, chip %2$s) or the battery is below %3$s</string>
    <string name="safety_off_body">Tests run without the app\'s limits, until you stop them. The phone\'s own thermal protection still works, but the app will not step in.</string>
    <string name="safety_off_title">Turn off device safety?</string>
    <string name="safety_off_text">Without it the app will not stop a test when the battery, the case or the chip gets too hot, or when the battery runs low. Long tests can make the phone very hot. Only the phone\'s own protection remains.</string>
