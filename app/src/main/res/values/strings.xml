    <!-- Modes -->
    <string name="mode_full">Max power</string>
    <string name="mode_full_detail">CPU, GPU and memory at once: the most power the phone can draw. A light gauge on screen.</string>
    <string name="mode_cinematic">Cinematic</string>
    <string name="mode_cinematic_detail">A real-time 3D scene on screen while every CPU core runs flat out.</string>
    <string name="mode_cpu">CPU</string>
    <string name="mode_cpu_detail">Every core with the load that draws the most power: FMA streaming through the caches.</string>
    <string name="mode_gpu">GPU</string>
    <string name="mode_gpu_detail">The GPU alone, with the burner that draws the most power.</string>
    <string name="mode_dry">Dry 100%</string>
    <string name="mode_dry_detail">Every core reads 100% busy, yet most of its arithmetic units do no work and the phone draws little power. A reference: 100% is not always a real load.</string>
    <string name="scene_pool">Pool</string>
    <string name="scene_pool_detail">A pool reactor glowing blue under water: simulated waves, reflections, particles, depth of field.</string>
    <string name="scene_forest">Forest</string>
    <string name="scene_forest_detail">A dense, misty forest in light rain, with sunbeams through the canopy and soft shadows.</string>
    <string name="scene_white">White</string>
    <string name="scene_white_detail">A white world of glass and mirror corridors and tunnels: crisp, clean, full of reflections.</string>

