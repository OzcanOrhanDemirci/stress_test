#version 450
// G3: bilinear texture sampling. Four independent coordinate streams walk a
// 16 MiB texture, so the texture units, their caches and DRAM all work.
// One iteration = 4 samples.
layout(local_size_x = 64) in;

layout(push_constant) uniform Params {
    uint iterations;
    uint resultOffset;
} params;

layout(std430, set = 0, binding = 0) writeonly buffer Results { uint results[]; };
layout(set = 0, binding = 1) uniform sampler2D noise;

shared uint digest;

void main() {
    if (gl_LocalInvocationIndex == 0u) digest = 0u;
    barrier();

    uint id = gl_GlobalInvocationID.x;
    vec2 uv0 = vec2(float(id & 255u), float(id >> 8u)) * (1.0 / 256.0);
    vec2 uv1 = uv0 + vec2(0.25, 0.50);
    vec2 uv2 = uv0 + vec2(0.50, 0.25);
    vec2 uv3 = uv0 + vec2(0.75, 0.75);
    vec4 acc0 = vec4(0.0), acc1 = vec4(0.0), acc2 = vec4(0.0), acc3 = vec4(0.0);
    for (uint i = 0u; i < params.iterations; ++i) {
        acc0 += textureLod(noise, uv0, 0.0); uv0 += vec2(0.01231, 0.00791);
        acc1 += textureLod(noise, uv1, 0.0); uv1 += vec2(-0.00913, 0.01117);
        acc2 += textureLod(noise, uv2, 0.0); uv2 += vec2(0.00677, -0.01379);
        acc3 += textureLod(noise, uv3, 0.0); uv3 += vec2(-0.01453, -0.00533);
    }

    vec4 sum = acc0 + acc1 + acc2 + acc3;
    atomicXor(digest, floatBitsToUint(sum.x) ^ floatBitsToUint(sum.y) ^ floatBitsToUint(sum.z) ^ floatBitsToUint(sum.w));
    barrier();
    if (gl_LocalInvocationIndex == 0u) results[params.resultOffset + gl_WorkGroupID.x] = digest;
}
