#version 450
// One physics step for every particle of the pool scene.
//
// Bubbles rise from the fuel assembly: buoyancy against drag, a sideways
// wobble, reborn at the bottom when they reach the surface. Sparks orbit the
// spiked ring in a vortex (as if the ring's field held them), feel gravity and
// drag, bounce off the deck, and die after a few seconds or in the water.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#include "particle_params.glsl"
#include "pool.glsl"

void storeParticle(uint i, Particle p) {
    particles[i].position = p.position;
    particles[i].velocity = p.velocity;
}

float random(inout uint seed) {
    seed = pcg(seed);
    return float(seed) * (1.0 / 4294967295.0);
}

void bubble(inout Particle p, inout uint seed) {
    p.position.xyz = CORE + vec3((random(seed) - 0.5) * 1.25, 0.8 + random(seed) * 0.25, (random(seed) - 0.5) * 1.25);
    p.velocity = vec4(0.0, 0.15 + random(seed) * 0.25, 0.0, KIND_BUBBLE);
    p.position.w = 0.0;
}

void spark(inout Particle p, inout uint seed) {
    float a = random(seed) * 2.0 * PI;
    float r = RING_R + (random(seed) - 0.5) * 0.25;
    p.position.xyz = RING_CENTRE + vec3(cos(a) * r, (random(seed) - 0.5) * 0.15, sin(a) * r);
    vec3 tangent = vec3(-sin(a), 0.0, cos(a));
    vec3 kick = (vec3(random(seed), random(seed), random(seed)) - 0.5) * 0.8;
    p.velocity = vec4(tangent * (1.6 + random(seed)) + vec3(0.0, 0.25 + random(seed) * 0.5, 0.0) + kick, KIND_SPARK);
    p.position.w = 0.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) return;
    Particle p = loadParticle(i);
    uint seed = pcg(i * 9781u + params.frame * 6271u + 17u);
    float dt = params.dt;

    if (params.frame == 0u) {
        // Half are bubbles. Stagger their start so they do not rise as one sheet.
        if (i < params.count / 2u) {
            bubble(p, seed);
            p.position.y += random(seed) * (-CORE.y - 0.9);
        } else {
            spark(p, seed);
            p.position.w = random(seed) * 4.0;
        }
        storeParticle(i, p);
        return;
    }

    if (p.velocity.w == KIND_BUBBLE) {
        p.velocity.y = min(p.velocity.y + 0.4 * dt, 0.75);
        vec3 wobble = vec3(sin(params.time * 3.1 + float(i) * 0.37), 0.0, cos(params.time * 2.3 + float(i) * 0.51)) * 0.12;
        p.position.xyz += (p.velocity.xyz + wobble) * dt;
        p.position.w += dt;
        if (p.position.y > -0.03 || length(p.position.xz) > POOL_R - 0.05) bubble(p, seed);
    } else {
        vec3 rel = p.position.xyz - RING_CENTRE;
        float radius = max(length(rel.xz), 1e-3);
        vec2 radial = rel.xz / radius;
        vec3 swirl = vec3(-radial.y, 0.0, radial.x) * 2.2;
        vec3 pull = vec3(radial.x, 0.0, radial.y) * (RING_R - radius) * 1.6 - vec3(0.0, rel.y * 0.6, 0.0);
        vec3 acceleration = (swirl - p.velocity.xyz) * 0.7 + pull + vec3(0.0, -0.9, 0.0);
        p.velocity.xyz += acceleration * dt;
        p.position.xyz += p.velocity.xyz * dt;
        p.position.w += dt;
        if (p.position.y < DECK_Y && length(p.position.xz) > POOL_R) {
            p.position.y = DECK_Y;
            p.velocity.y = abs(p.velocity.y) * 0.45;
        }
        float lifetime = 3.0 + fract(float(i) * 0.618034) * 3.0;
        if (p.position.w > lifetime || (p.position.y < 0.0 && length(p.position.xz) < POOL_R)) spark(p, seed);
    }
    storeParticle(i, p);
}
