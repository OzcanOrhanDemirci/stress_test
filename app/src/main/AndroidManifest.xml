<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".StressApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stress"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The entry for lab sessions started over adb (tools/lab.mjs). A lab
            session wakes the screen, shows over the lock screen and loads the
            phone for as long as it is told to, so it must not be startable by
            other apps: this entry needs DUMP, which the adb shell holds and an
            installed app cannot be granted. The launcher entry ignores lab
            extras altogether.
        -->
        <activity-alias
            android:name=".LabActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:targetActivity=".MainActivity" />

        <!-- Shares the PDF and CSV reports with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>
    </application>

</manifest>
